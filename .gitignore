**/data
**/.snakemake
**/log_files

# dataset configs stay outside the repository (or as local folders/symlinks here): only the example is tracked
config/*
!config/README.md
!config/example/

# own SLURM profile (e.g. a symlink), used by run.sh instead of profiles/slurm/ when present
profiles/local

# container image and model weights (default locations in config/example/config.yml)
resources/

# optional local Helvetica (commercial font, not redistributable; see workflow/scripts/utils/plotting.py)
workflow/scripts/utils/fonts/

# scratch and docs folder
workflow/scratch
workflow/docs/

# pixi environments (pixi.lock is tracked, it is baked into the container)
.pixi/

# CUDA JIT and fontconfig caches written to $HOME inside containers
.nv/
.fontconfig/

# personal Claude Code settings
.claude/settings.local.json
**/misc

# Ignore data files
*.pdf
*.png
*.jpg
*.svg
*.tif
*.tiff
*.txt
*.tsv
*.csv
# except the per-panel tables of the example config (signatures, virtues, kronos2, channel_names), which are pipeline inputs
!config/example/**/*.csv
*.xlsx
*.xls
*.json
*.xml
#*.yaml
*.parquet
*.pq
*.pickle
*.pkl
*.pt
*.zarr
*.rds
*.rdata
*.Rdata
*.RData
*.h5
*.h5ad
*.lndb
*.soma
*.dill
*.sif
*.tdb
*.bpcells

# Ignore compressed files
*.zip
*.gz
*.bz2
*.xz
*.tar
*.rar

# Ignore sbatch err, out
*.err
*.out


# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C/C++ extensions
*.c
*.cpp
*.cc
*.so

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# Jupyter Notebook
.ipynb_checkpoints

# Dask worker cache
dask-worker-space/

# pyenv
.python-version

# celery beat schedule file
celerybeat-schedule

# SageMath parsed files
*.sage.py

# dotenv
.env

# virtualenv
.venv
venv/
ENV/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/

# IDE settings
.vscode/
.idea/
